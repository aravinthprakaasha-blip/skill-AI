# ---- Core ----
APP_ENV=development                      # "production" disables the local code runner and enforces JWT_SECRET
DATABASE_URL=                            # default: SQLite file in backend/. Production: postgresql://user:pass@host:5432/skillforge
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=                              # REQUIRED in production: long random string (e.g. `openssl rand -hex 32`)
SEED_DEMO_DATA=true                      # creates demo accounts (password: skillforge-demo). Never enable for real users.

# ---- Supabase Auth (optional) ----
SUPABASE_URL=                            # https://<project>.supabase.co - verifies Supabase's new (asymmetric) JWT signing keys
SUPABASE_JWT_SECRET=                     # only for projects still on the legacy HS256 JWT secret

# ---- Google Gemini (optional) ----
GEMINI_API_KEY=                          # without it, every AI step uses a labelled deterministic fallback
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ---- Code execution ----
JUDGE0_URL=                              # self-hosted: http://localhost:2358 | free hosted: https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=                          # X-Auth-Token (self-hosted AUTHN_TOKEN) or RapidAPI key
RUNNER_URL=                              # free alternative: the secret-free runner service in runner/
RUNNER_TOKEN=                            # must equal RUNNER_TOKEN on the runner service
ALLOW_LOCAL_RUNNER=                      # default: true in development, false in production. NOT a sandbox.
EXEC_TIME_LIMIT_S=5
EXEC_MEMORY_LIMIT_KB=256000

# ---- Background jobs ----
REDIS_URL=                               # e.g. redis://localhost:6379/0 -> workflows run on an RQ worker

GITHUB_ENRICHMENT=false                  # read public repo languages as Tier 0 signals
